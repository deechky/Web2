{
  "title": "Travel Planner - Overview",
  "uid": "travelplanner-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "tags": ["travel-planner", "observability"],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "label": "Servis",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": {
          "query": "label_values({exported_job=~\"TravelPlanner/(gateway|auth-service|trip-service|sharing-service)\"}, exported_job)",
          "refId": "service-variable"
        },
        "multi": true,
        "includeAll": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Traffic (RED)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "id": 2,
      "title": "Request rate (req/s) po servisu",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (exported_job) (rate(http_server_request_duration_seconds_count{exported_job=~\"$service\"}[1m]))",
          "legendFormat": "{{exported_job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error rate (5xx, %) po servisu",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (exported_job) (rate(http_server_request_duration_seconds_count{exported_job=~\"$service\", http_response_status_code=~\"5..\"}[1m])) / sum by (exported_job) (rate(http_server_request_duration_seconds_count{exported_job=~\"$service\"}[1m]))",
          "legendFormat": "{{exported_job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Latency p95 po servisu",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, exported_job) (rate(http_server_request_duration_seconds_bucket{exported_job=~\"$service\"}[1m])))",
          "legendFormat": "{{exported_job}} p95",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Resursi (CPU / Memory / GC)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false
    },
    {
      "id": 11,
      "title": "Process memory (working set) po servisu",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "dotnet_process_memory_working_set_bytes{exported_job=~\"$service\"}",
          "legendFormat": "{{exported_job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "CPU time (rate) po servisu",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (exported_job) (rate(dotnet_process_cpu_time_seconds_total{exported_job=~\"$service\"}[1m]))",
          "legendFormat": "{{exported_job}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "GC heap size po servisu",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "dotnet_gc_last_collection_heap_size_bytes{exported_job=~\"$service\"}",
          "legendFormat": "{{exported_job}} / gen {{gc_heap_generation}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "title": "Logovi (poslednji, filtrirani po servisu)",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false
    },
    {
      "id": 21,
      "title": "Log stream",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 19 },
      "targets": [
        {
          "expr": "{service_name=~\"$service\"}",
          "refId": "A"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending" }
    }
  ]
}
