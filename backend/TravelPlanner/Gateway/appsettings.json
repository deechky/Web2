{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "users-route": {
        "ClusterId": "auth-cluster",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "trip-shares-collection-route": {
        "ClusterId": "sharing-cluster",
        "Order": 1,
        "Match": { "Path": "/api/trips/{tripId}/shares" }
      },
      "trip-shares-nested-route": {
        "ClusterId": "sharing-cluster",
        "Order": 1,
        "Match": { "Path": "/api/trips/{tripId}/shares/{**catch-all}" }
      },
      "shares-route": {
        "ClusterId": "sharing-cluster",
        "Match": { "Path": "/api/shares/{**catch-all}" }
      },
      "trips-route": {
        "ClusterId": "trip-cluster",
        "Order": 5,
        "Match": { "Path": "/api/trips/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:8772/" }
        }
      },
      "trip-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:8726/" }
        }
      },
      "sharing-cluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:8420/" }
        }
      }
    }
  }
}
